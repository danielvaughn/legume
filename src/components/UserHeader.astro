---
interface Props {
  bio: Bio;
}

const { bio } = Astro.props;
const telHref = `tel:${bio.phone.replace(/[^+\d]/g, "")}`;
---

<header class="text-center mt-8 max-w-content mx-auto px-5 md:px-0">
  <h1 class="text-3xl font-bold tracking-wide">
    <a
      href="/"
      class="hover:text-accent hover:underline dark:hover:text-accent-bright dark:text-neutral-100"
    >
      {bio.name}
    </a>
  </h1>
  <nav>
    <ul class="flex items-baseline justify-center flex-wrap">
      <li>
        <a
          class="text-accent dark:text-accent-bright hover:underline whitespace-nowrap"
          href={telHref}
        >
          {bio.phone}
        </a>
      </li>
      <li>
        <a
          class="text-accent dark:text-accent-bright hover:underline whitespace-nowrap"
          href={`mailto:${bio.email}`}
        >
          {bio.email}
        </a>
      </li>
      <li>
        <a
          target="_blank"
          class="text-accent dark:text-accent-bright hover:underline whitespace-nowrap"
          href={bio.linkedin}
        >
          {bio.linkedin.replace("https://www.", "")}
        </a>
      </li>
      <li>
        <a
          target="_blank"
          class="text-accent dark:text-accent-bright hover:underline whitespace-nowrap"
          href={bio.github}
        >
          {bio.github.replace("https://", "")}
        </a>
      </li>
    </ul>
  </nav>
  <nav aria-label="Site" class="mt-2 print:hidden">
    <ul class="flex items-baseline justify-center gap-x-5">
      <li>
        <a
          href="/"
          class="uppercase text-sm tracking-widest hover:text-accent hover:underline dark:hover:text-accent-bright"
        >
          Résumé
        </a>
      </li>
      <li>
        <a
          href="/posts"
          class="uppercase text-sm tracking-widest hover:text-accent hover:underline dark:hover:text-accent-bright"
        >
          Writing
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  header nav ul li:after {
    content: "•";
    @apply px-1 text-neutral-300;
  }

  header nav ul li:last-of-type:after {
    content: "";
  }
</style>
