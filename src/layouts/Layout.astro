---
import "../styles/global.css";
import "@fontsource-variable/eb-garamond";
import { getSiteConfig } from "../utils/site";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const site = await getSiteConfig();
const pageTitle = title ? `${site.title} - ${title}` : site.title;
const canonicalUrl = new URL(Astro.url.pathname, site.canonical_url);
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={site.description} />
    <meta name="author" content={site.author} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={site.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:raw>
  body {
    font-family: "EB Garamond Variable";
    @apply sm:text-lg text-neutral-900 dark:bg-gray-900 dark:text-gray-400;
    text-rendering: optimizeLegibility;
  }
</style>
