---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found">
  <main class="max-w-content mx-auto px-5 pt-16 text-center">
    <h1 class="text-3xl font-bold tracking-wide">Page not found</h1>
    <p class="mt-3">There is nothing at this address.</p>
    <nav class="mt-4">
      <a href="/" class="text-accent dark:text-accent-bright hover:underline">
        Back to the résumé
      </a>
      <span class="px-2 text-neutral-400 select-none">•</span>
      <a href="/posts" class="text-accent dark:text-accent-bright hover:underline">
        Browse the writing
      </a>
    </nav>
  </main>
</Layout>
