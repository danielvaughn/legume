---
import UserHeader from "../../components/UserHeader.astro";
import Layout from "../../layouts/Layout.astro";
import {
  getPostTitle,
  getPublishedPosts,
  sortPosts,
} from "../../utils/posts";
import { getResume } from "../../utils/resume";

const resume = await getResume();
const posts = sortPosts(await getPublishedPosts());

const dateFormat = new Intl.DateTimeFormat("en", {
  month: "short",
  year: "numeric",
});
---

<Layout title="Writing">
  <UserHeader bio={resume.bio} />
  <main class="max-w-content mx-auto px-5 pb-12 md:px-0">
    <section class="mt-6">
      <header class="border-black border-b-2 pb-1">
        <h2 class="uppercase font-bold tracking-wide select-none">Writing</h2>
      </header>

      {posts.length === 0 && <p class="mt-4">Nothing published yet.</p>}

      <ul class="mt-2">
        {
          posts.map((post) => (
            <li class="my-3">
              <a
                href={`/posts/${post.id}`}
                class="font-bold hover:text-accent hover:underline dark:hover:text-accent-bright"
              >
                {getPostTitle(resume, post)}
              </a>
              {post.data.date && (
                <span class="text-sm text-neutral-600 dark:text-neutral-400 ml-2 whitespace-nowrap">
                  {dateFormat.format(post.data.date)}
                </span>
              )}
              {post.data.summary && (
                <p class="text-neutral-600 dark:text-neutral-400 leading-snug">
                  {post.data.summary}
                </p>
              )}
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Layout>
