---
import UserHeader from "../../components/UserHeader.astro";
import JobHeader from "../../components/JobHeader.astro";
import Layout from "../../layouts/Layout.astro";
import {
  getPostTitle,
  getPublishedPosts,
  getResumePartialByPost,
} from "../../utils/posts";
import HighlightHeader from "../../components/HighlightHeader.astro";
import { getResume } from "../../utils/resume";
import { render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { slug } = Astro.params;
const { post } = Astro.props;

const { Content } = await render(post);

// An invalid résumé is a content bug that must fail the build.
const resume = await getResume();

const resumePartial = getResumePartialByPost(resume, slug as string);
const postTitle = getPostTitle(resume, post);
---

<Layout title={postTitle} description={post.data.summary} type="article">
  <UserHeader bio={resume.bio} />
  <main class="max-w-3xl mx-auto px-5 pb-12 md:px-0">
    <section class="mt-6">
      {resumePartial.type === "job" && <JobHeader job={resumePartial.data} />}

      {
        resumePartial.type === "highlight" && (
          <HighlightHeader
            job={resumePartial.data.job}
            highlight={resumePartial.data.highlight}
          />
        )
      }

      <article class="mt-6 md-content"><Content /></article>
    </section>
  </main>
</Layout>

<style is:global>
  .md-content p {
    @apply mb-2 leading-snug text-lg text-pretty;
  }

  .md-content a {
    @apply text-blue-700 hover:underline dark:text-blue-500;
  }

  .md-content p > code {
    @apply text-xs text-emerald-200 bg-emerald-900 px-1 py-px;
  }

  .md-content pre.astro-code {
    @apply p-3 my-3 leading-normal;
    font-size: 12px;
  }

  .md-content h2 {
    @apply capitalize font-bold mt-5 tracking-wider;
  }

  .md-content h3 {
    @apply font-bold mt-4 tracking-wide;
  }

  .md-content ol {
    @apply list-decimal pl-4;
  }

  .md-content ul {
    @apply list-disc pl-4;
  }

  .md-content blockquote {
    @apply border-l-4 border-neutral-300 pl-3 italic my-3 dark:border-neutral-600;
  }

  .md-content img {
    @apply block mx-auto my-4 max-w-full h-auto;
  }

  /* An emphasized line directly after an image reads as its caption. */
  .md-content img + em {
    @apply block text-center text-sm text-neutral-600 -mt-2 mb-4 dark:text-neutral-400;
  }
</style>
